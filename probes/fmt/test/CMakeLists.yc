fun add_fmt_test(name) (
  cmake_parse_arguments ADD_FMT_TEST "HEADER_ONLY;MODULE" "" "" ${ARGN};
  sources := "${name}.cc", ${ADD_FMT_TEST_UNPARSED_ARGUMENTS};
  if ${ADD_FMT_TEST_HEADER_ONLY} then (
    sources := ${sources}, ${TEST_MAIN_SRC}, "../src/os.cc";
    libs := "gtest", "fmt-header-only";
    if match ${CMAKE_CXX_COMPILER_ID} "Clang" then (
      PEDANTIC_COMPILE_FLAGS := ${PEDANTIC_COMPILE_FLAGS}, '-Wno-weak-vtables'
    )
  ) else (
    if ${ADD_FMT_TEST_MODULE} then (
      libs := "test-main", "fmt-module"
    ) else (
      libs := "test-main", "fmt"
    )
  );
  add_exe ${name} ${sources};
  link_lib ${name} :PUBLIC ${libs};
  if ${ADD_FMT_TEST_HEADER_ONLY} and not ${FMT_UNICODE} then (
    compile_defs ${name} :PUBLIC 'FMT_UNICODE=0'
  );
  if ${FMT_PEDANTIC} then (
    compile_opts ${name} :PRIVATE ${PEDANTIC_COMPILE_FLAGS}
  );
  if ${FMT_WERROR} then (
    compile_opts ${name} :PRIVATE ${WERROR_FLAG}
  );
  add_test NAME ${name} COMMAND ${name}
);
add_subdirectory "gtest";
TEST_MAIN_SRC := "test-main.cc", "gtest-extra.cc", "gtest-extra.h", "util.cc";
add_lib test-main ${TEST_MAIN_SRC} ~type:STATIC;
include_dirs test-main :PUBLIC "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>";
link_lib test-main :PUBLIC gtest fmt;
add_fmt_test "args-test";
add_fmt_test "base-test";
add_fmt_test "assert-test";
add_fmt_test "chrono-test";
add_fmt_test "color-test";
add_fmt_test "gtest-extra-test";
add_fmt_test "format-test" "mock-allocator.h";
if ${MSVC} then (
  compile_opts format-test :PRIVATE '/bigobj'
);
if not ( ${MSVC} and ${BUILD_SHARED_LIBS} ) then (
  add_fmt_test "format-impl-test" "HEADER_ONLY" "header-only-test.cc"
);
add_fmt_test "ostream-test";
add_fmt_test "compile-test";
add_fmt_test "printf-test";
add_fmt_test "ranges-test" "ranges-odr-test.cc";
add_fmt_test "no-builtin-types-test" "HEADER_ONLY";
add_fmt_test "scan-test" "HEADER_ONLY";
add_fmt_test "std-test";
string_regex_replace '.*libfound \"([^\"]*)\".*' '\\1' "${RAWOUTPUT}" ~out:STDLIBFS;
if ${STDLIBFS} then (
  link_lib std-test :PUBLIC ${STDLIBFS}
);
add_fmt_test "unicode-test" "HEADER_ONLY";
if ${MSVC} then (
  compile_opts unicode-test :PRIVATE '/utf-8'
);
add_fmt_test "xchar-test";
add_fmt_test "enforce-checks-test";
compile_defs enforce-checks-test :PRIVATE '-DFMT_ENFORCE_COMPILE_STRING';
add_exe perf-sanity "perf-sanity.cc";
link_lib perf-sanity :PUBLIC "fmt::fmt";
if ${FMT_MODULE} then (
  add_fmt_test "module-test" MODULE
);
message "FMT_PEDANTIC: ${FMT_PEDANTIC}";
if ${FMT_PEDANTIC} then (
  if not str_eq ${CMAKE_CXX_COMPILER_ID} "Intel" then (
    check_cxx_compiler_flag '-fno-exceptions' HAVE_FNO_EXCEPTIONS_FLAG
  );
  if ${HAVE_FNO_EXCEPTIONS_FLAG} then (
    add_lib noexception-test "../src/format.cc" "noexception-test.cc";
    include_dirs noexception-test :PRIVATE "${PROJECT_SOURCE_DIR}/include";
    compile_opts noexception-test :PRIVATE '-fno-exceptions';
    compile_opts noexception-test :PRIVATE ${PEDANTIC_COMPILE_FLAGS}
  );
  add_lib nolocale-test "../src/format.cc";
  include_dirs nolocale-test :PRIVATE "${PROJECT_SOURCE_DIR}/include";
  compile_defs nolocale-test :PRIVATE 'FMT_STATIC_THOUSANDS_SEPARATOR=1'
);
if ${FMT_PEDANTIC} and not ${WIN32} and not ( match ${CMAKE_CXX_COMPILER_ID} "GNU" and ver_lt ${CMAKE_CXX_COMPILER_VERSION} "4.9" ) then (
  add_test NAME "compile-error-test" COMMAND ${CMAKE_CTEST_COMMAND} "--build-and-test" "${CMAKE_CURRENT_SOURCE_DIR}/compile-error-test" "${CMAKE_CURRENT_BINARY_DIR}/compile-error-test" "--build-generator" "${CMAKE_GENERATOR}" "--build-makeprogram" "${CMAKE_MAKE_PROGRAM}" "--build-options" "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}" "-DCMAKE_CXX_FLAGS=${CMAKE_CXX_FLAGS}" "-DCMAKE_CXX_STANDARD=${CMAKE_CXX_STANDARD}" "-DCXX_STANDARD_FLAG=${CXX_STANDARD_FLAG}" "-DFMT_DIR=${CMAKE_SOURCE_DIR}";
  add_test NAME "find-package-test" "-C" "${CMAKE_BUILD_TYPE}" COMMAND ${CMAKE_CTEST_COMMAND} "--build-and-test" "${CMAKE_CURRENT_SOURCE_DIR}/find-package-test" "${CMAKE_CURRENT_BINARY_DIR}/find-package-test" "--build-generator" "${CMAKE_GENERATOR}" "--build-makeprogram" "${CMAKE_MAKE_PROGRAM}" "--build-options" "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}" "-DCMAKE_CXX_FLAGS=${CMAKE_CXX_FLAGS}" "-DCMAKE_CXX_STANDARD=${CMAKE_CXX_STANDARD}" "-DFMT_DIR=${PROJECT_BINARY_DIR}" "-DPEDANTIC_COMPILE_FLAGS=${PEDANTIC_COMPILE_FLAGS}" "-DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}";
  add_test NAME "add-subdirectory-test" "-C" "${CMAKE_BUILD_TYPE}" COMMAND ${CMAKE_CTEST_COMMAND} "--build-and-test" "${CMAKE_CURRENT_SOURCE_DIR}/add-subdirectory-test" "${CMAKE_CURRENT_BINARY_DIR}/add-subdirectory-test" "--build-generator" "${CMAKE_GENERATOR}" "--build-makeprogram" "${CMAKE_MAKE_PROGRAM}" "--build-options" "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}" "-DCMAKE_CXX_STANDARD=${CMAKE_CXX_STANDARD}" "-DPEDANTIC_COMPILE_FLAGS=${PEDANTIC_COMPILE_FLAGS}" "-DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}"
);
if ${FMT_PEDANTIC} and not ${WIN32} then (
  add_test NAME "static-export-test" "-C" "${CMAKE_BUILD_TYPE}" COMMAND ${CMAKE_CTEST_COMMAND} "--build-and-test" "${CMAKE_CURRENT_SOURCE_DIR}/static-export-test" "${CMAKE_CURRENT_BINARY_DIR}/static-export-test" "--build-generator" "${CMAKE_GENERATOR}" "--build-makeprogram" "${CMAKE_MAKE_PROGRAM}" "--build-options" "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}" "-DCMAKE_CXX_STANDARD=${CMAKE_CXX_STANDARD}" "-DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}"
);
if ${FMT_CUDA_TEST} then (
  if ver_lt ${CMAKE_VERSION} "3.15" then (
    find_package CUDA "9.0"
  ) else (
    include CheckLanguage;
    check_language CUDA;
    if ${CMAKE_CUDA_COMPILER} then (
      enable_language CUDA OPTIONAL;
      CUDA_FOUND := TRUE
    )
  );
  if ${CUDA_FOUND} then (
    add_subdirectory "cuda-test";
    add_test NAME "cuda-test" COMMAND "fmt-in-cuda-test"
  )
);
enable_language C;
add_exe c-test "c-test.c";
link_lib c-test :PRIVATE "fmt::fmt-c";
add_test NAME "c-test" COMMAND "c-test"
