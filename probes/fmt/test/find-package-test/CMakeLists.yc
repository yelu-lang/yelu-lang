cmake_minimum_required VERSION '3.8...3.25';
project 'fmt-test';
find_package 'FMT' REQUIRED;
add_exe library-test 'main.cc';
link_lib library-test Public 'fmt::fmt';
compile_opts library-test Private $PEDANTIC_COMPILE_FLAGS;
include_dirs library-test Public '.' ~system;
if target target "fmt::fmt-header-only" then (
  add_exe header-only-test 'main.cc';
  link_lib header-only-test Public 'fmt::fmt-header-only';
  compile_opts header-only-test Private $PEDANTIC_COMPILE_FLAGS;
  include_dirs header-only-test Public '.' ~system
)

