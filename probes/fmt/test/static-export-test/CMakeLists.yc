cmake_minimum_required VERSION "3.8...3.25";
project "fmt-link" "CXX";
BUILD_SHARED_LIBS := OFF;
CMAKE_VISIBILITY_INLINES_HIDDEN := TRUE;
CMAKE_CXX_VISIBILITY_PRESET := 'hidden';
if $CMAKE_COMPILER_IS_GNUCXX and ver_lt $CMAKE_CXX_COMPILER_VERSION "5" then (
  BROKEN_LTO := ON
);
if not $BROKEN_LTO and ver_gt $CMAKE_VERSION "3.8" then (
  include "CheckIPOSupported";
  check_ipo_supported RESULT "HAVE_IPO";
  if $HAVE_IPO then (
    CMAKE_INTERPROCEDURAL_OPTIMIZATION := TRUE
  )
);
add_subdirectory "../.." "fmt";
set_property target fmt PROPERTY POSITION_INDEPENDENT_CODE ON;
add_lib library-test "library.cc" ~type:SHARED;
link_lib library-test :PRIVATE "fmt::fmt";
add_exe exe-test "main.cc";
link_lib exe-test :PRIVATE "library-test"
