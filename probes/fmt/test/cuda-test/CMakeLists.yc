add_lib Target fmt-in-cuda-test "cuda-cpp14.cu" "cpp14.cc" ~type:SHARED;

  list_append "CUDA_NVCC_FLAGS" '-std=c++14';
  if ${MSVC} then (
    list_append "CUDA_NVCC_FLAGS" '-Xcompiler' '/std:c++14';
    list_append "CUDA_NVCC_FLAGS" '-Xcompiler' '/Zc:__cplusplus'
  );
  cuda_add_executable fmt-in-cuda-test "cuda-cpp14.cu" "cpp14.cc";

  set_target_properties Target fmt-in-cuda-test PROPERTIES CUDA_SEPARABLE_COMPILATION ON;
  compile_feats Target fmt-in-cuda-test :PRIVATE 'cxx_std_14';

  if ${MSVC} then (
    set_property SOURCE "cuda-cpp14.cu" APPEND PROPERTY COMPILE_OPTIONS "-Xcompiler" "/std:c++14" "-Xcompiler" "/Zc:__cplusplus";
    set_property SOURCE "cpp14.cc" APPEND PROPERTY COMPILE_OPTIONS "/std:c++14" "/Zc:__cplusplus"
  );

  get_target_property IN_USE_CUDA_STANDARD Target fmt-in-cuda-test CUDA_STANDARD;
  message "cuda_standard: ${IN_USE_CUDA_STANDARD}";
  get_target_property IN_USE_CUDA_STANDARD_REQUIRED Target fmt-in-cuda-test CUDA_STANDARD_REQUIRED;
  message "cuda_standard_required: ${IN_USE_CUDA_STANDARD_REQUIRED}";
  target_link_libraries Target fmt-in-cuda-test :PUBLIC "fmt::fmt"
