cmake_minimum_required VERSION "3.8...3.28";
include_guard GLOBAL;
if ver_lt ${CMAKE_VERSION} "3.12" then (
  policy_set CMP0074 NEW
);
if not ( defined FMT_MASTER_PROJECT ) then (
  FMT_MASTER_PROJECT := "OFF";
  if not ( defined PROJECT_NAME ) then (
    FMT_MASTER_PROJECT := "ON";
    message "CMake version: ${CMAKE_VERSION}"
  )
);
fun join(result_var) (
  result := "";
  foreach arg in LISTS ARGN (
    result := "${result}${arg}"
  );
  ${result_var} := "${result}" PARENT_SCOPE
);
fun set_verbose(variable, value, _cache, type) (
  join "doc" ${ARGN};
  cache ${variable} := ${value} '${doc}' ~type:${type}
);
if ${FMT_MASTER_PROJECT} and not ${CMAKE_BUILD_TYPE} then (
  set_verbose "CMAKE_BUILD_TYPE" "Release" "CACHE" "STRING" "Choose the type of build, options are: None(CMAKE_CXX_FLAGS or " "CMAKE_C_FLAGS used) Debug Release RelWithDebInfo MinSizeRel."
);
project FMT CXX;
FMT_USE_CMAKE_MODULES := "FALSE";
if ver_ge ${CMAKE_VERSION} "3.28" and ver_ge ${CMAKE_CXX_STANDARD} "20" then (
  if str_eq ${CMAKE_GENERATOR} "Ninja" then (
    execute_process COMMAND ${CMAKE_MAKE_PROGRAM} "--version" OUTPUT_VARIABLE NINJA_VERSION;
    if ver_ge ${NINJA_VERSION} "1.11" then (
      if ( str_eq ${CMAKE_CXX_COMPILER_ID} "GNU" and ver_ge ${CMAKE_CXX_COMPILER_VERSION} "15" ) or ( str_eq ${CMAKE_CXX_COMPILER_ID} "Clang" and ver_ge ${CMAKE_CXX_COMPILER_VERSION} "16" ) or ( str_eq ${CMAKE_CXX_COMPILER_ID} "MSVC" and ver_ge ${MSVC_VERSION} "1934" ) then (
        FMT_USE_CMAKE_MODULES := "TRUE"
      )
    )
  ) else (
    if match ${CMAKE_GENERATOR} "^Visual Studio" and ver_ge ${MSVC_VERSION} "1934" then (
      FMT_USE_CMAKE_MODULES := "TRUE"
    )
  )
);
option FMT_DOC "Generate the doc target." ${FMT_MASTER_PROJECT};
option FMT_INSTALL "Generate the install target." ${FMT_MASTER_PROJECT};
option FMT_TEST "Generate the test target." ${FMT_MASTER_PROJECT};
option FMT_FUZZ "Generate the fuzz target." OFF;
option FMT_CUDA_TEST "Generate the cuda-test target." OFF;
option FMT_OS "Include OS-specific APIs." ON;
option FMT_MODULE "Build a module library." ${FMT_USE_CMAKE_MODULES};
option FMT_SYSTEM_HEADERS "Expose headers with marking them as system." OFF;
option FMT_UNICODE "Enable Unicode support." ON;
option FMT_PEDANTIC "Enable extra warnings and expensive tests." OFF;
option FMT_WERROR "Halt the compilation with an error on compiler warnings." OFF;
FMT_SYSTEM_HEADERS_ATTRIBUTE := "";
if ${FMT_SYSTEM_HEADERS} then (
  FMT_SYSTEM_HEADERS_ATTRIBUTE := "SYSTEM"
);
include GNUInstallDirs;
set_verbose "FMT_INC_DIR" ${CMAKE_INSTALL_INCLUDEDIR} "CACHE" "STRING" "Installation directory for include files, a relative path that " "will be joined with ${CMAKE_INSTALL_PREFIX} or an absolute path.";
cache FMT_DEBUG_POSTFIX := "d" 'Debug library postfix.' ~type:STRING;
file_read "include/fmt/base.h" ~out:base_h;
if not ( match ${base_h} "FMT_VERSION ([0-9]+)([0-9][0-9])([0-9][0-9])" ) then (
  message FATAL_ERROR "Cannot get FMT_VERSION from base.h."
);
math "${CMAKE_MATCH_1}" ~out:CPACK_PACKAGE_VERSION_MAJOR;
math "${CMAKE_MATCH_2}" ~out:CPACK_PACKAGE_VERSION_MINOR;
math "${CMAKE_MATCH_3}" ~out:CPACK_PACKAGE_VERSION_PATCH;
join "FMT_VERSION" "${CPACK_PACKAGE_VERSION_MAJOR}.${CPACK_PACKAGE_VERSION_MINOR}." "${CPACK_PACKAGE_VERSION_PATCH}";
message "{fmt} version: ${FMT_VERSION}";
message "Build type: ${CMAKE_BUILD_TYPE}";
if not ${CMAKE_RUNTIME_OUTPUT_DIRECTORY} then (
  CMAKE_RUNTIME_OUTPUT_DIRECTORY := "${CMAKE_CURRENT_BINARY_DIR}/bin"
);
list_append CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/support/cmake";
include CheckCXXCompilerFlag;
include JoinPaths;
if ${FMT_MASTER_PROJECT} and not ( defined CMAKE_CXX_VISIBILITY_PRESET ) then (
  set_verbose "CMAKE_CXX_VISIBILITY_PRESET" "hidden" "CACHE" "STRING" "Preset for the export of private symbols.";
  set_property CACHE CMAKE_CXX_VISIBILITY_PRESET PROPERTY STRINGS hidden default
);
if ${FMT_MASTER_PROJECT} and not ( defined CMAKE_VISIBILITY_INLINES_HIDDEN ) then (
  set_verbose "CMAKE_VISIBILITY_INLINES_HIDDEN" "ON" "CACHE" "BOOL" "Whether to add a compile flag to hide symbols of inline " "functions."
);
if match ${CMAKE_CXX_COMPILER_ID} "GNU" then (
  PEDANTIC_COMPILE_FLAGS := "-pedantic-errors", "-Wall", "-Wextra", "-pedantic", "-Wold-style-cast", "-Wundef", "-Wredundant-decls", "-Wwrite-strings", "-Wpointer-arith", "-Wcast-qual", "-Wformat=2", "-Wmissing-include-dirs", "-Wcast-align", "-Wctor-dtor-privacy", "-Wdisabled-optimization", "-Winvalid-pch", "-Woverloaded-virtual", "-Wconversion", "-Wundef", "-Wno-ctor-dtor-privacy", "-Wno-format-nonliteral";
  if not ( ver_lt ${CMAKE_CXX_COMPILER_VERSION} "4.6" ) then (
    PEDANTIC_COMPILE_FLAGS := ${PEDANTIC_COMPILE_FLAGS}, "-Wno-dangling-else", "-Wno-unused-local-typedefs"
  );
  if not ( ver_lt ${CMAKE_CXX_COMPILER_VERSION} "5.0" ) then (
    PEDANTIC_COMPILE_FLAGS := ${PEDANTIC_COMPILE_FLAGS}, "-Wdouble-promotion", "-Wtrampolines", "-Wzero-as-null-pointer-constant", "-Wuseless-cast", "-Wvector-operation-performance", "-Wsized-deallocation", "-Wshadow"
  );
  if not ( ver_lt ${CMAKE_CXX_COMPILER_VERSION} "6.0" ) then (
    PEDANTIC_COMPILE_FLAGS := ${PEDANTIC_COMPILE_FLAGS}, "-Wshift-overflow=2", "-Wduplicated-cond";
    if ver_lt ${CMAKE_CXX_COMPILER_VERSION} "12.0" then (
      PEDANTIC_COMPILE_FLAGS := ${PEDANTIC_COMPILE_FLAGS}, "-Wnull-dereference"
    )
  );
  WERROR_FLAG := "-Werror"
);
if match ${CMAKE_CXX_COMPILER_ID} "Clang" then (
  PEDANTIC_COMPILE_FLAGS := "-Wall", "-Wextra", "-pedantic", "-Wconversion", "-Wundef", "-Wdeprecated", "-Wweak-vtables", "-Wshadow", "-Wno-gnu-zero-variadic-macro-arguments";
  check_cxx_compiler_flag "-Wzero-as-null-pointer-constant" HAS_NULLPTR_WARNING;
  if ${HAS_NULLPTR_WARNING} then (
    PEDANTIC_COMPILE_FLAGS := ${PEDANTIC_COMPILE_FLAGS}, "-Wzero-as-null-pointer-constant"
  );
  WERROR_FLAG := "-Werror"
);
if ${MSVC} then (
  PEDANTIC_COMPILE_FLAGS := "/W3";
  WERROR_FLAG := "/WX"
);
if ${FMT_MASTER_PROJECT} and match ${CMAKE_GENERATOR} "Visual Studio" then (
  include FindSetEnv;
  if ${WINSDK_SETENV} then (
    MSBUILD_SETUP := "call \"${WINSDK_SETENV}\""
  );
  join netfxpath "C:\\Program Files\\Reference Assemblies\\Microsoft\\Framework\\" ".NETFramework\\v4.0";
  file_write "run-msbuild.bat" "${MSBUILD_SETUP}
  ${CMAKE_MAKE_PROGRAM} -p:FrameworkPathOverride=\"${netfxpath}\" %*"
);
fun setup_target(tgt, kind) (
  add_lib_alias "fmt::${tgt}" ~alias_of:"${tgt}";
  include_dirs ${tgt} ${FMT_SYSTEM_HEADERS_ATTRIBUTE} BEFORE ${kind} "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>" "$<INSTALL_INTERFACE:${FMT_INC_DIR}>";
  if not ${MSVC} then (  ) else (
    if ${FMT_UNICODE} then (
      compile_opts ${tgt} ${kind} "$<$<AND:$<COMPILE_LANGUAGE:CXX>,$<CXX_COMPILER_ID:MSVC>>:/utf-8>"
    ) else (
      compile_defs ${tgt} ${kind} 'FMT_UNICODE=0'
    )
  );
  set_target_properties ${tgt} PROPERTY VERSION ${FMT_VERSION} PROPERTY SOVERSION ${CPACK_PACKAGE_VERSION_MAJOR} PROPERTY DEBUG_POSTFIX "${FMT_DEBUG_POSTFIX}"
);
FMT_HEADERS := "";
foreach header in [ "args.h" "base.h" "chrono.h" "color.h" "compile.h" "core.h" "format.h" "format-inl.h" "os.h" "ostream.h" "printf.h" "ranges.h" "std.h" "xchar.h" ] (
  FMT_HEADERS := ${FMT_HEADERS}, "include/fmt/${header}"
);
add_lib fmt "src/format.cc" ${FMT_HEADERS} "README.md" "ChangeLog.md";
setup_target "fmt" "PUBLIC";
set_target_properties fmt PROPERTY PUBLIC_HEADER "${FMT_HEADERS}";
if ${FMT_OS} then (
  target_sources fmt :PRIVATE "src/os.cc"
) else (
  compile_defs fmt :PRIVATE 'FMT_OS=0'
);
if ${FMT_WERROR} then (
  compile_opts fmt :PRIVATE ${WERROR_FLAG}
);
if ${FMT_PEDANTIC} then (
  compile_opts fmt :PRIVATE ${PEDANTIC_COMPILE_FLAGS}
);
if list_in "cxx_std_11" ${CMAKE_CXX_COMPILE_FEATURES} then (
  compile_feats fmt :PUBLIC 'cxx_std_11'
) else (
  message WARNING "Feature cxx_std_11 is unknown for the CXX compiler"
);
FMT_LIB_NAME := "fmt";
if str_eq ${CMAKE_BUILD_TYPE} "Debug" then (
  FMT_LIB_NAME := "${FMT_LIB_NAME}${FMT_DEBUG_POSTFIX}"
);
if ${BUILD_SHARED_LIBS} then (
  compile_defs fmt :PRIVATE 'FMT_LIB_EXPORT';
  compile_defs fmt :INTERFACE 'FMT_SHARED'
);
if ${FMT_SAFE_DURATION_CAST} then (
  compile_defs fmt :PUBLIC 'FMT_SAFE_DURATION_CAST'
);
fun add_module_library(name) (
  cmake_parse_arguments AML "" "USE_CMAKE_MODULES" "" ${ARGN};
  sources := ${AML_UNPARSED_ARGUMENTS};
  add_lib ${name} ${sources};
  set_target_properties ${name} PROPERTY LINKER_LANGUAGE CXX;
  compile_feats ${name} :PUBLIC 'cxx_std_20';
  if ${MSVC} then (
    if not ( str_eq ${CMAKE_GENERATOR} "Ninja" ) then (
      BMI_DIR := "${CMAKE_CURRENT_BINARY_DIR}";
      path_convert_to_native "${BMI_DIR}/${name}.ifc" ~out:BMI;
      compile_opts ${name} :PRIVATE "/interface" "/ifcOutput" ${BMI} INTERFACE "/reference" "fmt=${BMI}";
      set_target_properties ${name} PROPERTY ADDITIONAL_CLEAN_FILES ${BMI};
      set_source_files_properties ${BMI} PROPERTIES GENERATED ON
    )
  );
  if ${AML_USE_CMAKE_MODULES} then (
    target_sources ${name} :PUBLIC FILE_SET fmt TYPE CXX_MODULES FILES ${sources};
    return
  );
  if ${CMAKE_COMPILER_IS_GNUCXX} then (
    compile_opts ${name} :PUBLIC "-fmodules-ts"
  );
  get_target_property std ${name} CXX_STANDARD;
  if match ${CMAKE_CXX_COMPILER_ID} "Clang" then (
    pcms := "";
    foreach src in LISTS sources (
      get_filename_component pcm ~mode:NAME_WE ${src};
      pcm := "${pcm}.pcm";
      compile_opts ${name} :PUBLIC "-fmodule-file=${CMAKE_CURRENT_BINARY_DIR}/${pcm}";
      pcms := ${pcms}, "${CMAKE_CURRENT_BINARY_DIR}/${pcm}";
      add_custom_command OUTPUT ${pcm} COMMAND ${CMAKE_CXX_COMPILER} "-std=c++${std}" "-x" "c++-module" "--precompile" "-c" "-o" ${pcm} "${CMAKE_CURRENT_SOURCE_DIR}/${src}" "-I$<JOIN:$<TARGET_PROPERTY:${name},INCLUDE_DIRECTORIES>,;-I>" COMMAND_EXPAND_LISTS DEPENDS ${src}
    );
    sources := "";
    foreach pcm in LISTS pcms (
      get_filename_component pcm_we ~mode:NAME_WE ${pcm};
      obj := "${pcm_we}.o";
      sources := ${sources}, ${pcm}, "${CMAKE_CURRENT_BINARY_DIR}/${obj}";
      add_custom_command OUTPUT ${obj} COMMAND ${CMAKE_CXX_COMPILER} "$<TARGET_PROPERTY:${name},COMPILE_OPTIONS>" "-c" "-o" ${obj} ${pcm} DEPENDS ${pcm}
    )
  );
  target_sources ${name} :PRIVATE ${sources}
);
if ${FMT_MODULE} then (
  add_module_library "fmt-module" "src/fmt.cc" USE_CMAKE_MODULES ${FMT_USE_CMAKE_MODULES};
  setup_target "fmt-module" "PUBLIC"
);
add_lib fmt-header-only ~type:INTERFACE;
compile_defs fmt-header-only :INTERFACE 'FMT_HEADER_ONLY=1';
compile_feats fmt-header-only :INTERFACE 'cxx_std_11';
setup_target "fmt-header-only" "INTERFACE";
add_lib fmt-c "src/fmt-c.cc" ~type:STATIC;
compile_feats fmt-c :INTERFACE 'c_std_11';
if ${MSVC} then (
  compile_opts fmt-c :PUBLIC "/Zc:preprocessor"
);
link_lib fmt-c :PUBLIC "fmt::fmt";
add_lib_alias "fmt::fmt-c" ~alias_of:"fmt-c";
set_target_properties fmt-c PROPERTY PUBLIC_HEADER "include/fmt/fmt-c.h";
if ${FMT_INSTALL} then (
  include CMakePackageConfigHelpers;
  set_verbose "FMT_CMAKE_DIR" "${CMAKE_INSTALL_LIBDIR}/cmake/fmt" "CACHE" "STRING" "Installation directory for cmake files, a relative path that " "will be joined with ${CMAKE_INSTALL_PREFIX} or an absolute " "path.";
  version_config := "${PROJECT_BINARY_DIR}/fmt-config-version.cmake";
  project_config := "${PROJECT_BINARY_DIR}/fmt-config.cmake";
  pkgconfig := "${PROJECT_BINARY_DIR}/fmt.pc";
  targets_export_name := "fmt-targets";
  set_verbose "FMT_LIB_DIR" ${CMAKE_INSTALL_LIBDIR} "CACHE" "STRING" "Installation directory for libraries, a relative path that " "will be joined to ${CMAKE_INSTALL_PREFIX} or an absolute path.";
  set_verbose "FMT_PKGCONFIG_DIR" "${CMAKE_INSTALL_LIBDIR}/pkgconfig" "CACHE" "STRING" "Installation directory for pkgconfig (.pc) files, a relative " "path that will be joined with ${CMAKE_INSTALL_PREFIX} or an " "absolute path.";
  write_basic_package_version_file ${version_config} ~compatibility:AnyNewerVersion ~version:${FMT_VERSION};
  join_paths "libdir_for_pc_file" "\\${exec_prefix}" "${FMT_LIB_DIR}";
  join_paths "includedir_for_pc_file" "\\${prefix}" "${FMT_INC_DIR}";
  configure_file "${PROJECT_SOURCE_DIR}/support/cmake/fmt.pc.in" "${pkgconfig}" "@ONLY";
  configure_package_config_file ${FMT_CMAKE_DIR} "${PROJECT_SOURCE_DIR}/support/cmake/fmt-config.cmake.in" ${project_config};
  INSTALL_TARGETS := "fmt", "fmt-header-only", "fmt-c";
  if ${FMT_MODULE} then (
    list_append INSTALL_TARGETS "fmt-module";
    if ${FMT_USE_CMAKE_MODULES} then (
      INSTALL_FILE_SET := FILE_SET, fmt, DESTINATION, "${FMT_INC_DIR}/fmt"
    )
  );
  install_targets ${INSTALL_TARGETS} COMPONENT "fmt_core" EXPORT ${targets_export_name} LIBRARY DESTINATION ${FMT_LIB_DIR} ARCHIVE DESTINATION ${FMT_LIB_DIR} PUBLIC_HEADER DESTINATION "${FMT_INC_DIR}/fmt" RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} ${INSTALL_FILE_SET};
  export ${targets_export_name} ~file:"${PROJECT_BINARY_DIR}/${targets_export_name}.cmake";
  install_files ${project_config} ${version_config} DESTINATION ${FMT_CMAKE_DIR} COMPONENT "fmt_core";
  install_export ${targets_export_name} DESTINATION ${FMT_CMAKE_DIR} NAMESPACE "fmt::" COMPONENT "fmt_core";
  install_files ${pkgconfig} DESTINATION ${FMT_PKGCONFIG_DIR} COMPONENT "fmt_core"
);
fun add_doc_target() (
  find_program ~name:"doxygen" ~path:"$ENV{ProgramFiles}/doxygen/bin" DOXYGEN;
  if not ${DOXYGEN} then (
    message "Target 'doc' disabled because doxygen not found";
    return
  );
  find_program ~name:"mkdocs" MKDOCS;
  if not ${MKDOCS} then (
    message "Target 'doc' disabled because mkdocs not found";
    return
  );
  sources := "";
  foreach source in [ "api.md" "index.md" "syntax.md" "get-started.md" "fmt.css" "fmt.js" ] (
    sources := ${sources}, "doc/${source}"
  );
  add_custom_target doc ~all COMMAND ${CMAKE_COMMAND} "-E" "env" "PYTHONPATH=${CMAKE_CURRENT_SOURCE_DIR}/support/python" ${MKDOCS} "build" "-f" "${CMAKE_CURRENT_SOURCE_DIR}/support/mkdocs.yml" "--site-dir" "${CMAKE_CURRENT_BINARY_DIR}/doc-html" "--no-directory-urls" SOURCES ${sources};
  install_directory "${CMAKE_CURRENT_BINARY_DIR}/doc-html/" DESTINATION "${CMAKE_INSTALL_DATAROOTDIR}/doc/fmt" COMPONENT "fmt_doc" OPTIONAL
);
if ${FMT_DOC} then (
  add_doc_target
);
if ${FMT_TEST} then (
  enable_testing;
  add_subdirectory "test"
);
if ${FMT_FUZZ} then (
  add_subdirectory "test/fuzzing";
  compile_defs fmt :PUBLIC 'FMT_FUZZ'
);
gitignore := "${PROJECT_SOURCE_DIR}/.gitignore";
if ${FMT_MASTER_PROJECT} and exists ${gitignore} then (
  file_strings ${gitignore} ~out:lines;
  list_remove_item lines "/doc/html";
  foreach line in LISTS lines (
    string_replace "." "[.]" "${line}" ~out:line;
    string_replace "*" ".*" "${line}" ~out:line;
    ignored_files := ${ignored_files}, "${line}$", "${line}/"
  );
  ignored_files := ${ignored_files}, "/.git", "/build/doxyxml", ".vagrant";
  CPACK_SOURCE_GENERATOR := "ZIP";
  CPACK_SOURCE_IGNORE_FILES := ${ignored_files};
  CPACK_SOURCE_PACKAGE_FILE_NAME := "fmt-${FMT_VERSION}";
  CPACK_PACKAGE_NAME := "fmt";
  CPACK_RESOURCE_FILE_README := "${PROJECT_SOURCE_DIR}/README.md";
  include CPack
)