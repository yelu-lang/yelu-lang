{
  "source_tree": "vendor/fmt",
  "yc": "probes/fmt/main.yc",
  "ref_from_git": true,
  "base_configure_args": [
    "-DBUILD_SHARED_LIBS=ON",
    "-DFMT_MASTER_PROJECT=OFF"
  ],
  "cells": [
    {
      "name": "core-lib",
      "doc": "All optional targets off: only libfmt from the root CMakeLists.txt. Built byte-identical via same-path sequential builds — no external deps.",
      "configure_args": [
        "-DFMT_TEST=OFF",
        "-DFMT_DOC=OFF",
        "-DFMT_INSTALL=OFF",
        "-DFMT_FUZZ=OFF",
        "-DFMT_CUDA_TEST=OFF"
      ],
      "strict_bytes": true,
      "check_script": "consume_fmt.sh"
    }
  ]
}
