; conf-run level tests: yelu → cmake text → cmake -P → exit_code check.
; Requires cmake on PATH. Run explicitly:
;   dune build @yelu/test/test-runcmake/runcmake-test
;   dune build @yelu/test/test-runcmake/runcmake-compat
;
; Not attached to (alias runtest) — cmake is an external dep not guaranteed in CI.

(executables
 (names test_list test_list2 test_list3 test_list4 test_string test_string2 test_string3 test_string_hex test_string_uuid test_math test_while test_separate_arguments test_return test_message test_message2 test_function test_foreach test_foreach2 test_if test_set test_set_env test_configure test_yelu_cmake test_yelu_cache_oracle test_runcmake_compat test_runcmake_yelu test_cmake_commands demo_variable_watch)
 (libraries base alcotest yelu_langs yelu_runner step_common))

(rule
 (alias runcmake-test)
 (action (progn
   (run ./test_list.exe)
   (run ./test_list2.exe)
   (run ./test_list3.exe)
   (run ./test_list4.exe)
   (run ./test_string.exe)
   (run ./test_string2.exe)
   (run ./test_string3.exe)
   (run ./test_string_hex.exe)
   (run ./test_string_uuid.exe)
   (run ./test_math.exe)
   (run ./test_while.exe)
   (run ./test_separate_arguments.exe)
   (run ./test_return.exe)
   (run ./test_message.exe)
   (run ./test_message2.exe)
   (run ./test_function.exe)
   (run ./test_foreach.exe)
   (run ./test_foreach2.exe)
   (run ./test_if.exe)
   (run ./test_set.exe)
   (run ./test_set_env.exe)
   (run ./test_yelu_cmake.exe)
   (run ./test_configure.exe)
   (run ./test_yelu_cache_oracle.exe))))

(rule
 (alias runcmake-compat)
 (action (run ./test_runcmake_compat.exe)))

(rule
 (alias runcmake-yelu)
 (action (run ./test_runcmake_yelu.exe)))

(rule
 (alias cmake-commands)
 (action (run ./test_cmake_commands.exe)))
