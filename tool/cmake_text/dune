; cmake_text: tools that operate on cmake text files.
; cmake_reprint.exe — JSON CST → typed IR → reprinted cmake text.
; cmake_cache_scan.exe — scan cmake for option()/set(...CACHE...) decls.
; cmake_name_index.exe — index function/macro name→def-site in a cmake corpus.
(executables
 (names cmake_reprint cmake_name_index cmake_cache_scan)
 (libraries base yojson yelu_langs unix))
